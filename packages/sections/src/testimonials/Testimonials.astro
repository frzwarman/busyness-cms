---
import Icon from '../primitives/Icon.astro';
import Picture from '../primitives/Picture.astro';
import SectionFrame from '../primitives/SectionFrame.astro';
import SectionIntro from '../primitives/SectionIntro.astro';
import type { SectionRenderProps } from '../render-context.ts';
import type { TestimonialsProps } from './schema.ts';

type Props = SectionRenderProps<TestimonialsProps>;
const { props: p, section } = Astro.props;
const items = p.variant === 'single' ? p.items.slice(0, 1) : p.items;
---
<SectionFrame section={section} theme={p.theme} spacing={p.spacing} class:list={[`v-${p.variant}`]}>
  <SectionIntro eyebrow={p.eyebrow} heading={p.heading} description={p.description} align={p.align} />
  <ul class="items" data-field="items">
    {items.map((t) => (
      <li class:list={['item', p.variant !== 'single' && 'card']}>
        <figure>
          {p.showRatings && t.rating > 0 && (
            <p class="stars" aria-label={`${t.rating} out of 5 stars`}>{Array.from({ length: 5 }, (_, i) => <Icon name="star" size={16} class={i < t.rating ? 'on' : 'off'} />)}</p>
          )}
          <blockquote><p class:list={[p.variant === 'single' && 't-h3']}>“{t.quote}”</p></blockquote>
          <figcaption>
            {t.image && <span class="avatar"><Picture image={t.image} sizes="48px" /></span>}
            <span><strong>{t.name}</strong>{t.role && <span class="muted"> · {t.role}</span>}</span>
          </figcaption>
        </figure>
      </li>
    ))}
  </ul>
</SectionFrame>
<style>
  .items { list-style: none; margin: 0; padding: 0; display: grid; gap: 1.5rem; }
  figure { margin: 0; display: grid; gap: 1rem; }
  blockquote { margin: 0; }
  figcaption { display: flex; align-items: center; gap: .75rem; font-size: .9375rem; }
  .avatar { width: 2.5rem; height: 2.5rem; border-radius: 999px; overflow: hidden; display: inline-block; }
  .avatar :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .stars { display: flex; gap: .125rem; margin: 0; color: var(--color-accent); }
  .stars :global(.on) { fill: currentColor; }
  .stars :global(.off) { opacity: .3; }
  .v-single .item { max-width: 44rem; margin-inline: auto; text-align: center; }
  .v-single figcaption, .v-single .stars { justify-content: center; }
  @media (min-width: 900px) {
    .v-grid .items { grid-template-columns: repeat(3, 1fr); }
    .v-columns .items { display: block; columns: 2; column-gap: 1.5rem; }
    .v-columns .item { break-inside: avoid; margin-bottom: 1.5rem; }
  }
</style>
