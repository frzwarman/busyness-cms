---
import type { SectionRenderProps } from '../render-context.ts';
import type { FooterProps } from './schema.ts';

type Props = SectionRenderProps<FooterProps>;
const { props: p, section, ctx } = Astro.props;
---
<footer id={section.id} data-section-id={section.id} data-section-type={section.type} class:list={['section', `theme-${p.theme}`, `spacing-${p.spacing}`, 'footer', `v-${p.variant}`]}>
  <div class="container">
    <div class="top">
      <div class="brand">
        <p class="name" data-field="brandName">{p.brandName}</p>
        {p.tagline && <p class="muted" data-field="tagline">{p.tagline}</p>}
      </div>
      {p.columns.length > 0 && (
        <nav class="cols" aria-label="Footer" data-field="columns">
          {p.columns.map((c) => (
            <div class="col">
              {c.title && <h2 class="ctitle">{c.title}</h2>}
              <ul>{c.links.map((l) => <li><a href={ctx.href(l.link) ?? '#'}>{l.label}</a></li>)}</ul>
            </div>
          ))}
        </nav>
      )}
    </div>
    <div class="bottom">
      {p.copyright && <p class="muted small" data-field="copyright">{p.copyright}</p>}
      {p.legalLinks.length > 0 && <ul class="legal" data-field="legalLinks">{p.legalLinks.map((l) => <li><a href={ctx.href(l.link) ?? '#'}>{l.label}</a></li>)}</ul>}
    </div>
  </div>
</footer>
<style>
  .top { display: grid; gap: 2.5rem; }
  .name { font-family: var(--font-heading); font-weight: var(--heading-weight); font-size: 1.25rem; }
  .brand { display: grid; gap: .5rem; max-width: 22rem; }
  .cols { display: grid; gap: 2rem; grid-template-columns: repeat(2, 1fr); }
  .ctitle { font-size: .8125rem; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; margin-bottom: .75rem; opacity: .8; }
  ul { list-style: none; margin: 0; padding: 0; display: grid; gap: .5rem; }
  a { color: inherit; text-decoration: none; opacity: .85; }
  a:hover { opacity: 1; text-decoration: underline; text-underline-offset: .25em; }
  .bottom { margin-top: 2.5rem; padding-top: 1.25rem; border-top: 1px solid var(--section-border); display: flex; flex-wrap: wrap; justify-content: space-between; gap: 1rem; }
  .legal { display: flex; gap: 1.25rem; }
  .small { font-size: .875rem; }
  .v-centered .top, .v-centered .bottom { text-align: center; justify-content: center; }
  .v-centered .brand { margin-inline: auto; }
  .v-centered .cols { justify-content: center; }
  .v-simple .top { grid-template-columns: 1fr auto; align-items: center; }
  .v-simple .cols { display: flex; gap: 2rem; } .v-simple .ctitle { display: none; } .v-simple .cols ul { display: flex; gap: 1.25rem; }
  @media (min-width: 900px) { .v-columns .top { grid-template-columns: 1.2fr 2fr; } .v-columns .cols { grid-template-columns: repeat(auto-fit, minmax(9rem, 1fr)); } }
</style>
