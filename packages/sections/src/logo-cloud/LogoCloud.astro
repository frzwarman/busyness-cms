---
import Picture from '../primitives/Picture.astro';
import SectionFrame from '../primitives/SectionFrame.astro';
import type { SectionRenderProps } from '../render-context.ts';
import type { LogoCloudProps } from './schema.ts';

type Props = SectionRenderProps<LogoCloudProps>;
const { props: p, section, ctx } = Astro.props;
---
<SectionFrame section={section} theme={p.theme} spacing={p.spacing} class:list={[`v-${p.variant}`, p.grayscale && 'gray']}>
  {p.heading && <p class="eyebrow center" data-field="heading">{p.heading}</p>}
  <ul class="logos" data-field="logos">
    {p.logos.map((l) => {
      const href = l.link ? ctx.href(l.link) : undefined;
      const inner = l.image ? <Picture image={{ ...l.image, alt: l.image.alt || l.name }} sizes="160px" class="logo" /> : <span class="name">{l.name}</span>;
      return <li>{href ? <a href={href} aria-label={l.name}>{inner}</a> : inner}</li>;
    })}
  </ul>
</SectionFrame>
<style>
  .center { text-align: center; margin-bottom: 1.5rem; }
  .logos { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; justify-content: center; align-items: center; gap: 1.5rem 3rem; }
  .logos :global(img.logo) { height: 2.5rem; width: auto; max-width: 10rem; object-fit: contain; }
  .gray .logos :global(img.logo) { filter: grayscale(1); opacity: .75; }
  .gray .logos a:hover :global(img.logo) { filter: none; opacity: 1; }
  .name { font-family: var(--font-heading); font-weight: var(--heading-weight); font-size: 1.125rem; opacity: .7; }
  .v-grid .logos { display: grid; grid-template-columns: repeat(2, 1fr); text-align: center; }
  @media (min-width: 700px) { .v-grid .logos { grid-template-columns: repeat(4, 1fr); } }
</style>
