{
  "$schema": "../edge/node_modules/wrangler/config-schema.json",
  // The Studio is a static single-page app served by Workers static assets (no worker script).
  "name": "siteos-studio",
  "compatibility_date": "2026-09-01",
  "assets": { "directory": "./dist", "not_found_handling": "single-page-application" },
  "observability": { "enabled": true }
}
