{
  "name": "@siteos/renderer",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "fonts": "node scripts/sync-fonts.mjs",
    "dev": "node scripts/sync-fonts.mjs && astro dev --port 4321",
    "dev:ci": "node scripts/sync-fonts.mjs && astro dev --port 4321 --ignore-lock",
    "build": "node scripts/sync-fonts.mjs && astro build",
    "preview": "astro preview",
    "typecheck": "astro check",
    "test": "vitest run"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.3.2",
    "@siteos/content-sdk": "workspace:*",
    "@siteos/design-system": "workspace:*",
    "@siteos/schemas": "workspace:*",
    "@siteos/sections": "workspace:*",
    "astro": "^7.3.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.6",
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/lora": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource-variable/playfair-display": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "typescript": "~5.9.3",
    "vitest": "^5.0.1"
  }
}
