---
import PublicPage from '../../../components/PublicPage.astro';
import { content, normalizeSlug } from '../../../lib/content.ts';

const site = Astro.params.site ?? '';
const slug = normalizeSlug(Astro.params.slug);
const published = await content().getPage(site, slug);
if (!published) {
  const to = await content().getRedirect(site, slug);
  if (to) return Astro.redirect(to.startsWith('/') ? `/s/${site}${to}` : to, 301);
  return new Response('Not found', { status: 404 });
}
---
<PublicPage published={published} sitePrefix={`/s/${site}`} />
