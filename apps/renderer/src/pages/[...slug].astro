---
import PublicPage from '../components/PublicPage.astro';
import { content, normalizeSlug, siteFromRequest } from '../lib/content.ts';

const siteSlug = siteFromRequest(Astro.request);
if (!siteSlug) {
  return new Response('No site is configured for this host. Set DEFAULT_SITE_SLUG or use /s/<site-slug>/.', { status: 404, headers: { 'Content-Type': 'text/plain' } });
}
const published = await content().getPage(siteSlug, normalizeSlug(Astro.params.slug));
if (!published) return new Response('Not found', { status: 404 });
---
<PublicPage published={published} />
