{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "siteos-edge",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "r2_buckets": [{ "binding": "ASSETS", "bucket_name": "siteos-assets" }],
  "vars": {
    // Production, non-secret configuration; .dev.vars overrides these for `wrangler dev`.
    // Secrets (UPLOAD_SIGNING_SECRET, CF_API_TOKEN) go in `wrangler secret put` / .dev.vars.
    "STUDIO_ORIGIN": "http://localhost:5180",
    "SUPABASE_URL": "",
    "SUPABASE_PUBLISHABLE_KEY": "",
    // Public base URL for asset bytes. Leave empty to serve from this worker at /assets/<key>.
    "PUBLIC_ASSET_BASE_URL": "",
    // Optional cache purge on publish: set CF_ZONE_ID here and CF_API_TOKEN as a secret.
    "CF_ZONE_ID": ""
  },
  "observability": { "enabled": true }
}
