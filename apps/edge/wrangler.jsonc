{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "siteos-edge",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "r2_buckets": [{ "binding": "ASSETS", "bucket_name": "siteos-assets" }],
  "vars": {
    // Non-secret configuration. Secrets (UPLOAD_SIGNING_SECRET) go in `wrangler secret put` / .dev.vars.
    "STUDIO_ORIGIN": "http://localhost:5180",
    "SUPABASE_URL": "",
    "SUPABASE_PUBLISHABLE_KEY": "",
    // Public base URL for asset bytes. Leave empty to serve from this worker at /assets/<key>.
    "PUBLIC_ASSET_BASE_URL": ""
  },
  "observability": { "enabled": true }
}
