# ---- Studio (apps/studio) ----
# URL of the Astro renderer that hosts the live preview iframe (dev: astro dev server)
VITE_PREVIEW_ORIGIN=http://localhost:4321
# Supabase (Milestone 2)
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Site served at "/" when the request has no /s/<site> prefix and no platform subdomain (optional)
DEFAULT_SITE_SLUG=
# Platform domain for subdomain routing, e.g. sites.example.com → kopi-sudut.sites.example.com (optional)
PUBLIC_PLATFORM_DOMAIN=

# ---- Renderer (apps/renderer) ----
# Origin allowed to drive the preview iframe via postMessage (dev: vite dev server)
PUBLIC_STUDIO_ORIGIN=http://localhost:5180
# Supabase (Milestone 3, published content reads only)
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Server-side ONLY (never shipped to a browser). Used by RLS tests and, later, the edge worker / publish route.
SUPABASE_SECRET_KEY=sb_secret_xxx

# ---- E2E (optional) ----
# A confirmed Supabase user the Playwright suite signs in as. Create one in Authentication → Users.
E2E_EMAIL=
E2E_PASSWORD=

# ---- Edge worker (apps/edge) ----
# Origin of the upload worker: `wrangler dev` locally, your deployed worker in production
VITE_EDGE_ORIGIN=http://localhost:8787
# Where asset bytes are served from. The worker serves them at /assets; point this at an R2 public/custom domain when you have one.
VITE_ASSET_BASE_URL=http://localhost:8787/assets
# Worker runtime config lives in apps/edge/wrangler.jsonc (vars) and apps/edge/.dev.vars (secrets; see .dev.vars.example)
