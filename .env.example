# ---- Studio (apps/studio) ----
# URL of the Astro renderer that hosts the live preview iframe (dev: astro dev server)
VITE_PREVIEW_ORIGIN=http://localhost:4321
# Supabase (Milestone 2)
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# ---- Renderer (apps/renderer) ----
# Origin allowed to drive the preview iframe via postMessage (dev: vite dev server)
PUBLIC_STUDIO_ORIGIN=http://localhost:5180
# Supabase (Milestone 3, published content reads only)
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# ---- Edge worker (apps/edge, Milestone 5) ----
R2_BUCKET=siteos-assets
R2_PUBLIC_BASE_URL=https://assets.example.com
